# https://developer.spotify.com/dashboard -> create app -> Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# must match the redirect URI registered in the dashboard exactly
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

FLASK_SECRET_KEY=change-me

# Leave QDRANT_URL empty to run Qdrant embedded (stored in QDRANT_PATH).
# With docker compose it's http://qdrant:6333, locally http://127.0.0.1:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=tracks

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PLAYLIST_SIZE=25
MIN_GOOD_HITS=60
GOOD_HIT_SCORE=0.45
MAX_TRACKS_PER_ARTIST=2
